<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Motorun yüzeyi buraya bağlanır (VLCVideoLayout veya PlayerView) -->
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
            style="@style/Spinner"
            android:id="@+id/buffering"
        
        android:layout_gravity="center"
         />

    <TextView
        android:id="@+id/status"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        tools:text="VLC motoruna geçiliyor…"
        tools:visibility="visible" />

    <!-- Kumanda paneli: OK/DPAD ile açılır, 5 sn sonra gizlenir -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_controls_scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/safe_margin_x"
        android:paddingEnd="@dimen/safe_margin_x"
        android:paddingTop="24dp"
        android:paddingBottom="@dimen/safe_margin_y"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Üst satır: geri düğmesi (yalnız dokunmatik) + başlık -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back"
                style="@style/PlayerButton"
                android:contentDescription="@string/touch_back"
                android:src="@drawable/ic_back"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/now_title"
                style="@style/Text.HeadlineMd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Film Adı" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time_current"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                tools:text="00:12:30" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />

            <TextView
                android:id="@+id/time_total"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                tools:text="01:48:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_prev"
                style="@style/PlayerButton"
                android:src="@drawable/ic_prev"
                android:contentDescription="Önceki" />

            <ImageView
                android:id="@+id/btn_rewind"
                style="@style/PlayerButton"
                android:src="@drawable/ic_rewind"
                android:contentDescription="Geri sar" />

            <ImageView
                android:id="@+id/btn_play_pause"
                style="@style/PlayerButton"
                android:src="@drawable/ic_pause"
                android:contentDescription="Oynat/Duraklat" />

            <ImageView
                android:id="@+id/btn_forward"
                style="@style/PlayerButton"
                android:src="@drawable/ic_forward"
                android:contentDescription="İleri sar" />

            <ImageView
                android:id="@+id/btn_next"
                style="@style/PlayerButton"
                android:src="@drawable/ic_next"
                android:contentDescription="Sonraki" />

            <ImageView
                android:id="@+id/btn_audio"
                style="@style/PlayerButton"
                android:src="@drawable/ic_audio"
                android:contentDescription="@string/track_audio" />

            <ImageView
                android:id="@+id/btn_subtitle"
                style="@style/PlayerButton"
                android:src="@drawable/ic_subtitle"
                android:contentDescription="@string/track_subtitle" />

            <ImageView
                android:id="@+id/btn_engine"
                style="@style/PlayerButton"
                android:src="@drawable/ic_engine"
                android:contentDescription="@string/switch_engine" />

            <TextView
                android:id="@+id/engine_label"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                tools:text="Motor: VLC" />

            <!-- Ses: yalnız dokunmatik. Televizyon kendi kumandasının ses tuşunu kullanır. -->
            <ImageView
                android:id="@+id/btn_volume"
                style="@style/PlayerButton"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/touch_mute"
                android:src="@drawable/ic_volume_up"
                android:visibility="gone"
                tools:visibility="visible" />

            <SeekBar
                android:id="@+id/volume"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/touch_volume"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
