<?xml version="1.0" encoding="utf-8"?>
<!--
  Dokunmatik ekranlarda her ekranın üstüne eklenen geri çubuğu.

  Yalnızca TouchNav ekliyor ve yalnızca parmakla dokunulan cihazlarda;
  televizyonda hiç oluşturulmaz, kumandanın odak sırasına karışmaz.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_container_lowest"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="16dp">

    <!-- Tek bir geniş dokunma alanı: ok + "Geri" yazısı birlikte tıklanıyor. -->
    <LinearLayout
        android:id="@+id/touch_back"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/sidebar_row_selector"
        android:clickable="true"
        android:contentDescription="@string/touch_back"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.HeadlineMd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:importantForAccessibility="no"
            android:text="@string/touch_back" />
    </LinearLayout>
</LinearLayout>
