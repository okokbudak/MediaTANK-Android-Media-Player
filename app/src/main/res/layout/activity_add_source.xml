<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:paddingStart="@dimen/safe_margin_x"
    android:paddingEnd="@dimen/safe_margin_x"
    android:paddingTop="@dimen/safe_margin_y"
    android:paddingBottom="@dimen/safe_margin_y">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/screen_title"
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_source_title" />

        <!-- Tür seçimi -->
        <RadioGroup
            android:id="@+id/type_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/type_m3u"
                style="@style/FormRadio"
                android:checked="true"
                android:text="@string/menu_add_m3u" />

            <RadioButton
                android:id="@+id/type_xtream"
                style="@style/FormRadio"
                android:text="@string/menu_add_xtream" />

            <RadioButton
                android:id="@+id/type_smb"
                style="@style/FormRadio"
                android:text="@string/menu_add_smb" />
        </RadioGroup>

        <EditText
            android:id="@+id/field_name"
            style="@style/FormField"
            android:hint="@string/field_name"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/field_url"
            style="@style/FormField"
            android:hint="@string/field_url"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/field_share"
            style="@style/FormField"
            android:hint="@string/field_smb_share"
            android:inputType="text"
            android:visibility="gone"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/field_username"
            style="@style/FormField"
            android:hint="@string/field_username"
            android:inputType="text"
            android:visibility="gone"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/field_password"
            style="@style/FormField"
            android:hint="@string/field_password"
            android:inputType="textPassword"
            android:visibility="gone"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/hint"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_save"
                style="@style/FormButton"
                android:text="@string/btn_save" />

            <TextView
                android:id="@+id/btn_cancel"
                style="@style/FormButton"
                android:layout_marginStart="12dp"
                android:text="@string/btn_cancel" />

            <TextView
                android:id="@+id/btn_clear"
                style="@style/FormButton"
                android:layout_marginStart="12dp"
                android:text="@string/menu_remove_sources" />
        </LinearLayout>

        <ProgressBar
            style="@style/Spinner"
            android:id="@+id/progress"
            
            android:layout_marginTop="16dp"
            
            android:visibility="gone" />

        <TextView
            android:id="@+id/existing_header"
            style="@style/Text.HeadlineMd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/saved_sources" />

        <TextView
            android:id="@+id/existing_hint"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:text="@string/saved_sources_hint" />

        <!-- Kayıtlı kaynak satırları koddan eklenir -->
        <LinearLayout
            android:id="@+id/existing_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
