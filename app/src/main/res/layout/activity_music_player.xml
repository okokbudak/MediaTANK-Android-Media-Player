<?xml version="1.0" encoding="utf-8"?>
<!-- Tam ekran "şu an çalıyor". Solda kapak/görsel alan, sağda sıra. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:keepScreenOn="true"
    android:orientation="horizontal"
    android:paddingStart="@dimen/safe_margin_x"
    android:paddingEnd="@dimen/safe_margin_x"
    android:paddingTop="@dimen/safe_margin_y"
    android:paddingBottom="@dimen/safe_margin_y">

    <!-- Sol: kapak + bilgi + kumanda -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@null"
            android:padding="40dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music" />

        <TextView
            android:id="@+id/track_title"
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Parça Adı" />

        <TextView
            android:id="@+id/track_meta"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Albüm klasörü · 3 / 12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time_current"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                tools:text="01:12" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />

            <TextView
                android:id="@+id/time_total"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                tools:text="04:05" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_shuffle"
                style="@style/PlayerButton"
                android:contentDescription="Karışık"
                android:src="@drawable/ic_shuffle" />

            <ImageView
                android:id="@+id/btn_prev"
                style="@style/PlayerButton"
                android:contentDescription="Önceki"
                android:src="@drawable/ic_prev" />

            <ImageView
                android:id="@+id/btn_play_pause"
                style="@style/PlayerButton"
                android:contentDescription="Oynat/Duraklat"
                android:src="@drawable/ic_pause" />

            <ImageView
                android:id="@+id/btn_next"
                style="@style/PlayerButton"
                android:contentDescription="Sonraki"
                android:src="@drawable/ic_next" />

            <ImageView
                android:id="@+id/btn_repeat"
                style="@style/PlayerButton"
                android:contentDescription="Tekrar"
                android:src="@drawable/ic_repeat" />
        </LinearLayout>

        <TextView
            android:id="@+id/mode_label"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="Karışık: kapalı · Tekrar: liste" />
    </LinearLayout>

    <!-- Sağ: çalma sırası -->
    <LinearLayout
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:orientation="vertical">

        <TextView
            style="@style/Text.HeadlineMd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/music_queue" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </LinearLayout>
</LinearLayout>
