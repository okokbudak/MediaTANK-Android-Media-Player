<?xml version="1.0" encoding="utf-8"?>
<!--
  Canlı kanal kartı: logo + ad + "CANLI" rozeti.

  Rozet FrameLayout ile kartın üstüne bindiriliyor, satırda yer kaplamıyor.
  Aynı satırda dursaydı metin sütununu daraltır ve "SD: beIN Sports 1" gibi
  adlar "SD: beIN Sp…" diye kırpılırdı.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_frame"
    android:layout_width="@dimen/channel_w"
    android:layout_height="@dimen/channel_h"
    android:layout_marginEnd="@dimen/card_gap"
    android:background="@drawable/card_selector"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_live" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/title"
                style="@style/Text.HeadlineMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="SD: beIN Sports 1" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="TR: Spor" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/badge"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_live_badge"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="@string/badge_live"
        android:textColor="@color/on_surface" />
</FrameLayout>
