<?xml version="1.0" encoding="utf-8"?>
<!--
  Ana ekran iki görünüm barındırır:
   · Ana Sayfa  → hero + yatay raylar (home_scroll)
   · Canlı/Film/Dizi → solda kategoriler, sağda içerik (browse_pane)

  En solda her zaman ince ikon şeridi durur.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

        <!-- ===== Ana Sayfa: hero + raylar ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/sidebar_width"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/safe_margin_y"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/safe_margin_x"
            android:paddingEnd="@dimen/safe_margin_x">

            <!-- Başlık şeridi: uygulama adı + arama ve yenileme -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/safe_margin_y">

                <TextView
                    android:id="@+id/home_title"
                    style="@style/Text.Display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/hero_search"
                    style="@style/ToolbarChip"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="6dp"
                    android:text="@string/search_title" />

                <TextView
                    android:id="@+id/home_refresh"
                    style="@style/ToolbarChip"
                    android:layout_marginStart="8dp"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawablePadding="6dp"
                    android:text="@string/menu_refresh" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rails_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/empty_hint"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/empty_hint"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Gözat: kategoriler + içerik ===== -->
    <LinearLayout
        android:id="@+id/browse_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/sidebar_width"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Sol sütun: kategoriler -->
        <LinearLayout
            android:layout_width="@dimen/category_width"
            android:layout_height="match_parent"
            android:background="@color/surface_container_lowest"
            android:orientation="vertical"
            android:paddingTop="@dimen/safe_margin_y"
            android:paddingBottom="@dimen/safe_margin_y">

            <TextView
                android:id="@+id/section_title"
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                tools:text="Filmler" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/category_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Sağ sütun: seçili kategorinin içeriği -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="@dimen/safe_margin_x"
            android:paddingTop="@dimen/safe_margin_y"
            android:paddingBottom="@dimen/safe_margin_y">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/content_title"
                    style="@style/Text.HeadlineMd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="FILM: En Yeniler 2025 · 499" />

                <TextView
                    android:id="@+id/btn_search"
                    style="@style/ToolbarChip"
                    android:layout_marginEnd="8dp"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="6dp"
                    android:text="@string/search_title" />

                <TextView
                    android:id="@+id/btn_view_mode"
                    style="@style/ToolbarChip"
                    tools:text="Kılavuz" />

                <TextView
                    android:id="@+id/btn_sort"
                    style="@style/ToolbarChip"
                    android:layout_marginStart="8dp"
                    tools:text="Sıra: Ada göre" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/content_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="6dp"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/content_empty"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    tools:text="Bu kategoride içerik yok" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Layer 3: ikon şeridi her zaman üstte -->
    <include
        android:id="@+id/sidebar"
        layout="@layout/view_sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <ProgressBar
            style="@style/Spinner"
            android:id="@+id/loading"
        
        android:layout_gravity="center"
        
        android:visibility="gone" />
</FrameLayout>
