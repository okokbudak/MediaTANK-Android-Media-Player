<?xml version="1.0" encoding="utf-8"?>
<!--
  Ana sayfadaki büyük bölüm kutusu: renkli zemin, iri ikon, altında başlık.
  Arka plan rengi koddan atanıyor ki her bölüm ayrı renkte olsun.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_frame"
    android:layout_width="170dp"
    android:layout_height="120dp"
    android:layout_marginEnd="@dimen/card_gap"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_live" />

    <TextView
        android:id="@+id/title"
        style="@style/Text.HeadlineMd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        tools:text="Canlı Kanallar" />

    <TextView
        android:id="@+id/count"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/on_surface"
        tools:text="343 kanal" />
</LinearLayout>
