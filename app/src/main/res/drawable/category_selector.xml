<?xml version="1.0" encoding="utf-8"?>
<!--
  Kategori satırı. Referans arayüzdeki gibi seçili kategori dolu bir blok,
  odaklanan kategori ise birincil renkte kenarlıkla ayrışıyor.
  Sıra önemli: odak, seçiliyi ezmeli.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container_high" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
