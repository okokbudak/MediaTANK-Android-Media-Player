<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Basılı ve odaklı aynı görünür: dokunmada da düğme tepki versin. -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container_high" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="1dp" android:color="@color/outline_variant" />
        </shape>
    </item>
</selector>
